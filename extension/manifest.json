{
  "manifest_version": 3,
  "name": "Link2Context",
  "version": "0.5.0",
  "description": "Paste a link into a web AI and Link2Context automatically fetches, cleans and injects the real content. / 在网页 AI 中只发链接，自动读取、清洗并注入真实内容。",
  "permissions": ["downloads", "clipboardWrite", "storage", "activeTab", "tabs", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["progress-ui.js", "delivery-mode.js", "content-script-v051.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Link2Context",
    "default_popup": "popup.html"
  }
}
